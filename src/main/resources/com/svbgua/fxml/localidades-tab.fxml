<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.svbgua.ui.LocalidadesAdminController">
    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>

    <top>
        <HBox spacing="10">
            <padding><Insets top="0" right="0" bottom="12" left="0"/></padding>
            <Button text="Actualizar" onAction="#actualizar"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="10">
            <Label text="Localidades (secciones del recinto)" styleClass="seccion-titulo"/>
            <TableView fx:id="tablaLocalidades" VBox.vgrow="ALWAYS">
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                <placeholder><Label text="No hay localidades registradas."/></placeholder>
                <columns>
                    <TableColumn fx:id="cLId" text="ID" maxWidth="60"/>
                    <TableColumn fx:id="cLNombre" text="Nombre"/>
                </columns>
            </TableView>
        </VBox>
    </center>

    <right>
        <VBox styleClass="tarjeta" spacing="12" prefWidth="400" minWidth="400">
            <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
            <BorderPane.margin><Insets left="16"/></BorderPane.margin>

            <Label fx:id="lblModoLocalidad" text="Nueva localidad" styleClass="seccion-titulo"/>
            <TextField fx:id="tfLNombre" promptText="Ej.: Preferencial, VIP de pie, Mesa"/>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Button text="Nueva" onAction="#nuevaLocalidad"/>
                <Button text="Guardar" styleClass="btn-primario" onAction="#guardarLocalidad"/>
                <Button text="Eliminar" styleClass="btn-peligro" onAction="#eliminarLocalidad"/>
            </HBox>
        </VBox>
    </right>
</BorderPane>
