<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.svbgua.ui.ArtistasAdminController">
    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>

    <top>
        <HBox spacing="10">
            <padding><Insets top="0" right="0" bottom="12" left="0"/></padding>
            <Button text="Actualizar" onAction="#actualizar"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="10">
            <Label text="Artistas" styleClass="seccion-titulo"/>
            <TableView fx:id="tablaArtistas" VBox.vgrow="ALWAYS">
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                <placeholder><Label text="No hay artistas registrados."/></placeholder>
                <columns>
                    <TableColumn fx:id="cAId" text="ID" maxWidth="60"/>
                    <TableColumn fx:id="cANombre" text="Nombre artístico"/>
                    <TableColumn fx:id="cAGenero" text="Género"/>
                    <TableColumn fx:id="cAPais" text="País"/>
                </columns>
            </TableView>
        </VBox>
    </center>

    <right>
        <VBox styleClass="tarjeta" spacing="12" prefWidth="400" minWidth="400">
            <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
            <BorderPane.margin><Insets left="16"/></BorderPane.margin>

            <Label fx:id="lblModoArtista" text="Nuevo artista" styleClass="seccion-titulo"/>
            <TextField fx:id="tfANombre" promptText="Nombre artístico (máx. 120)"/>
            <TextField fx:id="tfAGenero" promptText="Género musical (máx. 50)"/>
            <TextField fx:id="tfAPais" promptText="País (opcional)"/>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Button text="Nuevo" onAction="#nuevoArtista"/>
                <Button text="Guardar" styleClass="btn-primario" onAction="#guardarArtista"/>
                <Button text="Eliminar" styleClass="btn-peligro" onAction="#eliminarArtista"/>
            </HBox>
        </VBox>
    </right>
</BorderPane>
