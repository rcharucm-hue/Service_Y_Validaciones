<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.svbgua.ui.UsuariosAdminController">
    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>

    <top>
        <HBox spacing="10">
            <padding><Insets top="0" right="0" bottom="12" left="0"/></padding>
            <Button text="Actualizar" onAction="#cargar"/>
        </HBox>
    </top>

    <center>
        <VBox>
            <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                <placeholder><Label text="No hay usuarios."/></placeholder>
                <columns>
                    <TableColumn fx:id="cId" text="ID" maxWidth="60"/>
                    <TableColumn fx:id="cUsuario" text="Usuario"/>
                    <TableColumn fx:id="cNombre" text="Nombre completo"/>
                    <TableColumn fx:id="cRol" text="Rol"/>
                </columns>
            </TableView>
        </VBox>
    </center>

    <right>
        <VBox styleClass="tarjeta" spacing="14" prefWidth="420" minWidth="420">
            <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
            <BorderPane.margin><Insets left="16"/></BorderPane.margin>

            <Label fx:id="lblModo" text="Nuevo usuario" styleClass="seccion-titulo"/>
            <GridPane hgap="10" vgap="10">
                <columnConstraints>
                    <ColumnConstraints/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>
                <Label text="Usuario:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <TextField fx:id="tfUsuario" promptText="Usuario" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                <Label text="Nombre:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <TextField fx:id="tfNombre" promptText="Nombre completo" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                <Label text="Contraseña:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <PasswordField fx:id="pfContrasena" promptText="Contraseña (mín. 8)" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                <Label text="Rol:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                <ComboBox fx:id="cbRol" value="vendedor" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="3">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="vendedor"/>
                            <String fx:value="administrador"/>
                        </FXCollections>
                    </items>
                </ComboBox>
            </GridPane>
            <Label text="Al editar, deja la contraseña en blanco para conservarla." styleClass="subtitulo" wrapText="true"/>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Button text="Nuevo" onAction="#limpiarFormulario"/>
                <Button text="Guardar" styleClass="btn-primario" onAction="#guardar"/>
                <Button text="Eliminar" styleClass="btn-peligro" onAction="#eliminar"/>
            </HBox>
        </VBox>
    </right>
</BorderPane>
