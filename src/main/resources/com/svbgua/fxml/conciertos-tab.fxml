<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.svbgua.ui.ConciertosAdminController">
    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>

    <top>
        <HBox spacing="10">
            <padding><Insets top="0" right="0" bottom="12" left="0"/></padding>
            <Button text="Actualizar" onAction="#actualizar"/>
        </HBox>
    </top>

    <center>
        <VBox>
            <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
                <placeholder>
                    <Label text="No hay conciertos registrados."/>
                </placeholder>
                <columns>
                    <TableColumn fx:id="cId" text="ID" maxWidth="60"/>
                    <TableColumn fx:id="cTitulo" text="Concierto"/>
                    <TableColumn fx:id="cArtista" text="Artista"/>
                    <TableColumn fx:id="cFecha" text="Fecha"/>
                    <TableColumn fx:id="cRecinto" text="Recinto"/>
                    <TableColumn fx:id="cEstado" text="Estado"/>
                </columns>
            </TableView>
        </VBox>
    </center>

    <right>
        <VBox styleClass="tarjeta" spacing="14" prefWidth="440" minWidth="440">
            <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
            <BorderPane.margin><Insets left="16"/></BorderPane.margin>

            <Label fx:id="lblModo" text="Nuevo concierto" styleClass="seccion-titulo"/>
            <GridPane hgap="10" vgap="10">
                <columnConstraints>
                    <ColumnConstraints/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>
                <Label text="Artista:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <HBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <ComboBox fx:id="cbArtista" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                    <Button text="+ Artista" onAction="#nuevoArtista"/>
                </HBox>
                <Label text="Título:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <TextField fx:id="tfTitulo" promptText="Título del evento" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                <Label text="Fecha:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <DatePicker fx:id="dpFecha" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                <Label text="Hora:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                <HBox spacing="6" alignment="CENTER_LEFT" GridPane.columnIndex="1" GridPane.rowIndex="3">
                    <Spinner fx:id="spHora" prefWidth="80"/>
                    <Label text=":"/>
                    <Spinner fx:id="spMinuto" prefWidth="80"/>
                    <Label text="(24 horas)" styleClass="subtitulo"/>
                </HBox>
                <Label text="Recinto:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                <TextField fx:id="tfRecinto" promptText="Recinto" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                <Label text="Estado:" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
                <ComboBox fx:id="cbEstado" value="programado" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="5">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="programado"/>
                            <String fx:value="activo"/>
                            <String fx:value="finalizado"/>
                        </FXCollections>
                    </items>
                </ComboBox>
            </GridPane>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Button text="Nuevo" onAction="#limpiarFormulario"/>
                <Button text="Guardar" styleClass="btn-primario" onAction="#guardar"/>
                <Button text="Eliminar" styleClass="btn-peligro" onAction="#eliminar"/>
            </HBox>
        </VBox>
    </right>
</BorderPane>